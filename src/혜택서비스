import java.util.Scanner;

public class CustomBenefitApp {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.println("=== 카테고리를 선택하세요 ===");
        System.out.println("1. 식비");
        System.out.println("2. 교통비");
        System.out.println("3. 기타");

        System.out.print("번호 입력: ");
        int choice = sc.nextInt();

        switch (choice) {
            case 1:
                System.out.println("\n[식비 관련 혜택은 아직 준비 중이에요!]");
                break;
            case 2:
                System.out.println("\n[교통비 줄일 수 있는 서비스를 추천할게요!]");
                // 이 아래에 구체적인 추천 항목을 출력해도 좋아!
                break;
            case 3:
                System.out.println("\n[기타 항목에 대한 정보가 없습니다.]");
                break;
            default:
                System.out.println("\n[잘못된 입력입니다.]");
        }

        sc.close();
    }
}
